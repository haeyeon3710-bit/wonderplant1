# Set real values in Netlify. Never commit .env or server secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
CMS_ENVIRONMENT=preview
SITE_URL=https://your-preview.netlify.app
# Random 32-byte base64url value. Server only; never put it in a public asset.
CMS_VIEW_SECRET=replace-with-a-generated-server-only-value
